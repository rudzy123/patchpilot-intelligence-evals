{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:patchpilot-intelligence-evals:schema:candidate-memory-budget:v1",
  "title": "Track 7B candidate memory budget",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "categoryId",
        "unit",
        "memoryDomain",
        "includedInTotal",
        "countsParameterPayload",
        "evidenceStatus",
        "valueType",
        "lowerBoundBytes",
        "upperBoundBytes",
        "logicalBytes",
        "logicalBytesIncludedInPeak",
        "formula",
        "inputs",
        "evidenceIds",
        "uncertainty",
        "contextTokens"
      ],
      "properties": {
        "categoryId": { "type": "string", "minLength": 3, "maxLength": 80 },
        "unit": { "const": "bytes" },
        "memoryDomain": { "const": "resident" },
        "includedInTotal": { "const": true },
        "countsParameterPayload": { "type": "boolean" },
        "evidenceStatus": {
          "enum": [
            "authoritative-measured",
            "authoritative-published-bound",
            "deterministic-calculation",
            "conservative-assumption",
            "unresolved"
          ]
        },
        "valueType": {
          "enum": [
            "published-measurement",
            "published-bound",
            "calculated",
            "assumption",
            "not-provided"
          ]
        },
        "lowerBoundBytes": { "type": ["integer", "null"], "minimum": 0 },
        "upperBoundBytes": { "type": ["integer", "null"], "minimum": 0 },
        "logicalBytes": { "type": ["integer", "null"], "minimum": 0 },
        "logicalBytesIncludedInPeak": { "const": false },
        "formula": { "type": "string", "minLength": 8, "maxLength": 120 },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 3, "maxLength": 80 }
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": { "type": "string", "minLength": 3, "maxLength": 80 }
        },
        "uncertainty": { "type": "string", "minLength": 10, "maxLength": 240 },
        "contextTokens": { "enum": [4096, 8192] }
      }
    }
  },
  "required": [
    "schemaVersion",
    "productionReady",
    "realModelExecuted",
    "runtimeInstallationStatus",
    "acquisitionStatus",
    "conversionStatus",
    "executionStatus",
    "locallyObservedArtifactDigests",
    "retrievedOn",
    "finalistModelId",
    "sourceRevision",
    "onnxRevision",
    "runtimeId",
    "runtimeVersionTag",
    "runtimeRevision",
    "precision",
    "batchSize",
    "processCount",
    "executionProvider",
    "quantizationApproved",
    "speculativeExecution",
    "automaticBatching",
    "ceilingBytes",
    "gibibyteBytes",
    "roundingRule",
    "overflowDomain",
    "measurementPerformed",
    "envelopes"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "productionReady": { "const": false },
    "realModelExecuted": { "const": false },
    "runtimeInstallationStatus": { "const": "not-installed" },
    "acquisitionStatus": { "const": "not-acquired" },
    "conversionStatus": { "const": "not-performed" },
    "executionStatus": { "const": "not-executed" },
    "locallyObservedArtifactDigests": { "type": "array", "maxItems": 0 },
    "retrievedOn": { "const": "2026-11-12" },
    "finalistModelId": { "const": "LiquidAI/LFM2.5-1.2B-Instruct" },
    "sourceRevision": { "const": "b9d816ab510f9a28dca37cb182e9da8b0226e13c" },
    "onnxRevision": { "const": "10f72e70abf67ac0fd7ebf15bc5854726891d864" },
    "runtimeId": { "const": "onnxruntime" },
    "runtimeVersionTag": { "const": "v1.31.1" },
    "runtimeRevision": { "const": "6af1a932e2286d5c58166085d24c68783033edee" },
    "precision": { "const": "fp32" },
    "batchSize": { "const": 1 },
    "processCount": { "const": 1 },
    "executionProvider": { "const": "cpu" },
    "quantizationApproved": { "const": false },
    "speculativeExecution": { "const": false },
    "automaticBatching": { "const": false },
    "ceilingBytes": { "const": 12884901888 },
    "gibibyteBytes": { "const": 1073741824 },
    "roundingRule": { "const": "integer-exact" },
    "overflowDomain": { "const": "signed-int64" },
    "measurementPerformed": { "const": false },
    "envelopes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contextTokens",
          "classification",
          "lowerBoundBytes",
          "upperBoundBytes",
          "ceilingBytes",
          "ceilingComparison",
          "bytesRelativeToCeiling",
          "unresolvedCategoryIds",
          "categories"
        ],
        "properties": {
          "contextTokens": { "enum": [4096, 8192] },
          "classification": { "enum": ["proven-pass", "proven-fail", "unresolved"] },
          "lowerBoundBytes": { "type": ["integer", "null"], "minimum": 0 },
          "upperBoundBytes": { "type": ["integer", "null"], "minimum": 0 },
          "ceilingBytes": { "const": 12884901888 },
          "ceilingComparison": { "enum": ["pass", "fail", "unresolved"] },
          "bytesRelativeToCeiling": { "type": ["integer", "null"] },
          "unresolvedCategoryIds": {
            "type": "array",
            "maxItems": 10,
            "items": { "type": "string", "minLength": 3, "maxLength": 80 }
          },
          "categories": {
            "type": "array",
            "minItems": 10,
            "maxItems": 10,
            "items": { "$ref": "#/$defs/category" }
          }
        }
      }
    }
  }
}
