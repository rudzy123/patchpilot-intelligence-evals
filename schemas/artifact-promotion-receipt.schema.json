{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:patchpilot-intelligence-evals:schema:artifact-promotion-receipt:v1",
  "title": "Artifact promotion receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "productionReady",
    "realModelExecuted",
    "runtimeInstallationStatus",
    "acquisitionStatus",
    "conversionStatus",
    "executionStatus",
    "locallyObservedArtifactDigests",
    "receiptState",
    "attemptId",
    "executionEligibility",
    "laterSessionEligibility",
    "logicalInventoryBytes",
    "allocatedInventoryBytes",
    "transientAcquisitionAuthorized",
    "transientAcquisitionOverheadBytes",
    "sameFilesystem",
    "syncSteps",
    "copyFallbackUsed",
    "crossDevice",
    "destinationCollision",
    "failureCategory",
    "inventoryIdentity",
    "sealIdentity",
    "recoveryProof",
    "operatorReviewRequired",
    "preVerificationMetadata",
    "postVerificationMetadata",
    "identityDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "productionReady": { "const": false },
    "realModelExecuted": { "const": false },
    "runtimeInstallationStatus": { "const": "not-installed" },
    "acquisitionStatus": { "const": "not-acquired" },
    "conversionStatus": { "const": "not-performed" },
    "executionStatus": { "const": "not-executed" },
    "locallyObservedArtifactDigests": { "type": "array", "maxItems": 0 },
    "receiptState": { "enum": ["not-acquired", "verified"] },
    "attemptId": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,40}$" }
      ]
    },
    "executionEligibility": { "const": "prohibited" },
    "laterSessionEligibility": { "enum": ["none", "verified-identity-only"] },
    "logicalInventoryBytes": {
      "oneOf": [
        { "type": "null" },
        { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 }
      ]
    },
    "allocatedInventoryBytes": { "type": "null" },
    "transientAcquisitionAuthorized": { "const": false },
    "transientAcquisitionOverheadBytes": { "type": "null" },
    "sameFilesystem": { "oneOf": [{ "type": "null" }, { "type": "boolean" }] },
    "syncSteps": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "enum": [
          "manifest-file",
          "quarantine-directory",
          "file-data",
          "rename-noreplace",
          "verified-parent-directory",
          "receipt-file",
          "verified-parent-directory-after-receipt"
        ]
      }
    },
    "copyFallbackUsed": { "const": false },
    "crossDevice": { "const": false },
    "destinationCollision": { "const": false },
    "failureCategory": { "type": "null" },
    "inventoryIdentity": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      ]
    },
    "sealIdentity": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      ]
    },
    "recoveryProof": { "enum": ["none", "explicit", "absent"] },
    "operatorReviewRequired": { "const": false },
    "preVerificationMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recorded", "logicalBytes", "fileCount"],
      "properties": {
        "recorded": { "type": "boolean" },
        "logicalBytes": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 }
          ]
        },
        "fileCount": { "type": "integer", "minimum": 0, "maximum": 32 }
      }
    },
    "postVerificationMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recorded", "logicalBytes", "fileCount"],
      "properties": {
        "recorded": { "type": "boolean" },
        "logicalBytes": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 }
          ]
        },
        "fileCount": { "type": "integer", "minimum": 0, "maximum": 32 }
      }
    },
    "identityDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "receiptState": { "const": "not-acquired" } },
        "required": ["receiptState"]
      },
      "then": {
        "properties": {
          "attemptId": { "type": "null" },
          "laterSessionEligibility": { "const": "none" },
          "logicalInventoryBytes": { "type": "null" },
          "sameFilesystem": { "type": "null" },
          "syncSteps": { "maxItems": 0 },
          "inventoryIdentity": { "type": "null" },
          "sealIdentity": { "type": "null" },
          "recoveryProof": { "const": "none" }
        }
      }
    },
    {
      "if": {
        "properties": { "receiptState": { "const": "verified" } },
        "required": ["receiptState"]
      },
      "then": {
        "properties": {
          "attemptId": { "type": "string" },
          "laterSessionEligibility": { "const": "verified-identity-only" },
          "sameFilesystem": { "const": true },
          "syncSteps": { "minItems": 7, "maxItems": 7 },
          "inventoryIdentity": { "type": "string" },
          "sealIdentity": { "type": "string" }
        }
      }
    }
  ]
}
