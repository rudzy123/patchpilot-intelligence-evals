      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "member", "sha256"],
      "properties": {
        "member": { "const": "onnxruntime-linux-x64-1.31.1/include/onnxruntime_c_api.h" },
        "sha256": {
          "const": "43d584f596ef66820421317df32a79a95fc1d39ee46cb3971a870c08d8ba4baa"
        },
        "bytes": { "const": 422790 }
      }
