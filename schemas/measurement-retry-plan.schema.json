    "chatTemplateSha256": {
      "const": "f05bf4b967dc993bdc7a2fe6e43759ee218eb0eb340d68b063e1c4f8ad148176"
    },
    "priorPlanDigest": {
      "const": "8280ec639abd60edad7d49c1129d691822c17be06d7ef15aa2fcb5425bdbf0a2"
    },
    "priorPlanDisposition": { "const": "consumed" },
    "priorPlanReusable": { "const": false },
    "replacementPlanDigest": { "const": "not-issued" },
