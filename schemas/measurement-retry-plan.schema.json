  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 80 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "decoding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "repetitionPenalty",
        "seed",
        "seedControl",
        "seedSupport",
        "temperature",
        "topK",
        "topP"
      ],
      "properties": {
        "method": { "const": "greedy-argmax" },
        "temperature": { "const": 0 },
        "topP": { "const": 1 },
        "topK": { "const": 1 },
        "repetitionPenalty": { "const": 1 },
        "seed": { "const": 0 },
        "seedSupport": { "const": false },
        "seedControl": { "const": "unused" }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batchSize",
        "coldWarm",
        "cpuSeconds",
        "generationBudgetSeconds",
        "inputTokens",
        "maxNewTokens",
        "order",
        "phase",
        "phaseBoundaryDwellMilliseconds",
        "prerequisite",
        "promptConstruction",
        "repetitions",
        "sampleIntervalMilliseconds",
        "stderrBytes",
        "stdoutBytes",
        "wallClockSeconds"
      ],
      "properties": {
        "order": { "type": "integer", "minimum": 1, "maximum": 7 },
        "phase": {
          "enum": [
            "preflight",
            "template-compatibility",
            "one-token-smoke",
            "short-generation",
            "context-4096",
            "context-8192",
            "corpus-evaluation"
          ]
        },
        "prerequisite": { "type": ["string", "null"] },
        "maxNewTokens": { "type": "integer", "minimum": 0 },
        "inputTokens": { "type": ["integer", "null"], "minimum": 0 },
        "batchSize": { "const": 1 },
        "repetitions": { "type": "integer", "minimum": 1 },
        "coldWarm": { "type": "boolean" },
        "promptConstruction": {
          "enum": [
            "none",
            "synthetic-fixture",
            "chat-template",
            "repeated-token-id",
            "protocol-request"
          ]
        },
        "wallClockSeconds": { "type": "integer", "minimum": 1 },
        "cpuSeconds": { "type": "integer", "minimum": 1 },
        "generationBudgetSeconds": { "type": "integer", "minimum": 1 },
        "stdoutBytes": { "type": "integer", "minimum": 1 },
        "stderrBytes": { "type": "integer", "minimum": 1 },
        "sampleIntervalMilliseconds": { "const": 100 },
        "phaseBoundaryDwellMilliseconds": { "const": 150 }
      }
    }
