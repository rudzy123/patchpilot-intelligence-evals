  "$defs": {
    "componentReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["componentId", "disposition", "statement"],
      "properties": {
        "componentId": { "type": "string", "minLength": 3, "maxLength": 80 },
        "disposition": {
          "enum": [
            "approved",
            "unresolved",
            "eligible-for-controlled-evaluation",
            "not-established",
            "authorized-in-principle-with-documented-residuals"
          ]
        },
        "statement": { "type": "string", "minLength": 10, "maxLength": 240 }
      }
    },
    "acceptedResidual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["residualId", "statement"],
      "properties": {
        "residualId": { "type": "string", "minLength": 3, "maxLength": 80 },
        "statement": { "type": "string", "minLength": 10, "maxLength": 240 }
      }
    }
