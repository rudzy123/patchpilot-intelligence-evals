    "locallyObservedConfigurationDigests": { "type": "array", "maxItems": 0 },
    "locallyObservedOnnxArtifactDigests": { "type": "array", "maxItems": 0 },
    "locallyObservedArtifactDigests": { "type": "array", "maxItems": 0 },
