{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:patchpilot-intelligence-evals:schema:candidate-behavioral-run:v1",
  "title": "Candidate behavioral run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "calibrationStatus",
    "caseId",
    "exitClassification",
    "identityDigest",
    "installationAuthorized",
    "networkResult",
    "outputDigest",
    "planDigest",
    "processCleanup",
    "productionReady",
    "realModelExecuted",
    "repetition",
    "repositoryCommit",
    "requestDigest",
    "schemaVersion",
    "selectionOutcome",
    "stopCause"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "productionReady": { "const": false },
    "selectionOutcome": { "const": "no-selection" },
    "calibrationStatus": { "const": "not-approved" },
    "installationAuthorized": { "const": false },
    "realModelExecuted": { "type": "boolean" },
    "caseId": { "type": "string", "minLength": 1, "maxLength": 40 },
    "repetition": { "type": "integer", "minimum": 0, "maximum": 3 },
    "planDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "requestDigest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "outputDigest": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "exitClassification": { "type": "string", "minLength": 1, "maxLength": 40 },
    "stopCause": { "type": ["string", "null"] },
    "processCleanup": { "enum": ["not-performed", "reaped", "failed"] },
    "networkResult": { "enum": ["not-performed", "denied", "failed"] },
    "repositoryCommit": { "type": "string", "minLength": 1, "maxLength": 40 },
    "identityDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
