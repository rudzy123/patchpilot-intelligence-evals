{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:patchpilot-intelligence-evals:schema:track8b-plan-disposition:v1",
  "title": "Track 8B plan disposition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "calibrationStatus",
    "identityDigest",
    "installationAuthorized",
    "nextRunRequiresNewPlan",
    "nextRunRequiresOperatorApproval",
    "planDigest",
    "planDisposition",
    "productionReady",
    "replacementPlanDigest",
    "reusable",
    "runInvoked",
    "schemaVersion",
    "selectionOutcome"
