    "nextRunRequiresNewPlan": { "const": true },
    "nextRunRequiresOperatorApproval": { "const": true },
    "runInvoked": { "const": false },
    "identityDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
