{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:patchpilot-intelligence-evals:schema:track9a-proportionality-review:v1",
  "title": "track9a-proportionality-review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authorizesAnotherRun",
    "authorizesReplacementPlan",
    "calibrationStatus",
    "comparisonWinner",
    "identityDigest",
    "installationAuthorized",
    "planDigest",
    "productionReady",
    "proportionalityRecommendation",
    "rationale",
    "replacementPlanDigest",
    "schemaVersion",
    "selectionOutcome",
    "sessionId",
    "track9AuthorizationDigest"
  ],
  "properties": {
    "authorizesAnotherRun": {
      "const": false
    },
    "authorizesReplacementPlan": {
      "const": false
    },
    "calibrationStatus": {
      "const": "not-approved"
    },
    "comparisonWinner": {
      "type": "null"
    },
    "identityDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "installationAuthorized": {
      "const": false
    },
    "planDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "productionReady": {
      "const": false
    },
    "proportionalityRecommendation": {
      "const": "review-required"
    },
    "rationale": {
      "const": "stopped-evidence-accepted-without-another-run"
    },
    "replacementPlanDigest": {
      "const": "not-issued"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "selectionOutcome": {
      "const": "no-selection"
    },
    "sessionId": {
      "const": "intelligence-track-9a"
    },
    "track9AuthorizationDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
