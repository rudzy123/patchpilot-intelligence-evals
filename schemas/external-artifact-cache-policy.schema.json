{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:patchpilot-intelligence-evals:schema:external-artifact-cache-policy:v1",
  "title": "External artifact cache policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "productionReady",
    "cacheLocation",
    "states",
    "executionFromQuarantine",
    "executionFromRejected",
    "tokenizerLoadingFromQuarantine",
    "modelLoadingFromQuarantine",
    "networkFallback",
    "gitTracking",
    "ciUpload",
    "tenantData",
    "rootRequirements",
    "siblingRepositoryNames",
    "approvedFormats",
    "cleanup",
    "promotionRequiresCompleteVerification",
    "acquisitionStatus",
    "executionStatus"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "productionReady": { "const": false },
    "cacheLocation": { "const": "repository-external" },
    "states": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        { "const": "quarantine" },
        { "const": "verified" },
        { "const": "rejected" }
      ],
      "items": false
    },
    "executionFromQuarantine": { "const": "prohibited" },
    "executionFromRejected": { "const": "prohibited" },
    "tokenizerLoadingFromQuarantine": { "const": "prohibited" },
    "modelLoadingFromQuarantine": { "const": "prohibited" },
    "networkFallback": { "const": "prohibited" },
    "gitTracking": { "const": "prohibited" },
    "ciUpload": { "const": "prohibited" },
    "tenantData": { "const": "prohibited" },
    "rootRequirements": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "explicit-root",
          "outside-git-repository",
          "outside-sibling-repositories",
          "reject-traversal",
          "reject-symlink-escape",
          "reject-repository-contained-root",
          "stable-root-during-validation"
        ]
      }
    },
    "siblingRepositoryNames": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["neural-from-scratch", "patchpilot"] }
    },
    "approvedFormats": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "const": "safetensors" }
    },
    "cleanup": { "const": "delete-attempt-payload-retain-reason-codes" },
    "promotionRequiresCompleteVerification": { "const": true },
    "acquisitionStatus": { "const": "not-acquired" },
    "executionStatus": { "const": "not-executed" }
  }
}
