{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:patchpilot-intelligence-evals:schema:finalist-explanation-suitability:v1",
  "title": "Track 7 finalist explanation suitability",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "sourceName",
        "url",
        "publisher",
        "retrievedOn",
        "immutableRevision",
        "claim",
        "evidenceClass",
        "applicability",
        "conflictDisposition"
      ],
      "properties": {
        "evidenceId": { "type": "string", "minLength": 3, "maxLength": 80 },
        "sourceName": { "type": "string", "minLength": 3, "maxLength": 120 },
        "url": {
          "type": "string",
          "pattern": "^https://[A-Za-z0-9.-]+(?:/[A-Za-z0-9._~:/?#\\[\\]!$&'()*+,;=%-]*)?$"
        },
        "publisher": { "type": "string", "minLength": 2, "maxLength": 80 },
        "retrievedOn": { "const": "2026-11-11" },
        "immutableRevision": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha" }]
        },
        "claim": { "type": "string", "pattern": "^[^\"']{20,400}$" },
        "evidenceClass": {
          "enum": ["authoritative", "secondary", "conflicting", "unresolved"]
        },
        "applicability": { "type": "string", "minLength": 3, "maxLength": 160 },
        "conflictDisposition": {
          "enum": ["none", "restrictive-reading", "rejected-unofficial", "unresolved"]
        }
      }
    }
  },
  "required": [
    "schemaVersion",
    "productionReady",
    "realModelExecuted",
    "runtimeInstallationStatus",
    "acquisitionStatus",
    "conversionStatus",
    "executionStatus",
    "retrievedOn",
    "finalistCount",
    "finalistModelIds",
    "measuredQualityClaimed",
    "locallyObservedArtifactDigests",
    "finalists"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "productionReady": { "const": false },
    "realModelExecuted": { "const": false },
    "runtimeInstallationStatus": { "const": "not-installed" },
    "acquisitionStatus": { "const": "not-acquired" },
    "conversionStatus": { "const": "not-performed" },
    "executionStatus": { "const": "not-executed" },
    "retrievedOn": { "const": "2026-11-11" },
    "finalistCount": { "type": "integer", "minimum": 0, "maximum": 4 },
    "finalistModelIds": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3, "maxLength": 160 }
    },
    "measuredQualityClaimed": { "const": false },
    "locallyObservedArtifactDigests": { "type": "array", "maxItems": 0 },
    "finalists": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["modelId", "assessments", "suitabilityOutcome", "evidence"],
        "properties": {
          "modelId": { "type": "string", "minLength": 3, "maxLength": 160 },
          "assessments": {
            "type": "array",
            "minItems": 10,
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["topic", "status", "evidenceId"],
              "properties": {
                "topic": {
                  "enum": [
                    "instructionFollowing",
                    "structuredOutput",
                    "englishLanguage",
                    "contextSufficiency",
                    "conciseGeneration",
                    "factualExplanationLimitations",
                    "safetyLimitations",
                    "citationIdReproduction",
                    "refusalAndUncertainty",
                    "deploymentCaveats"
                  ]
                },
                "status": {
                  "enum": ["supported", "unsupported", "stated", "not-stated", "unresolved"]
                },
                "evidenceId": { "type": "string", "minLength": 3, "maxLength": 80 }
              }
            }
          },
          "suitabilityOutcome": {
            "enum": ["suitable-for-offline-evaluation", "unsuitable", "unresolved"]
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": { "$ref": "#/$defs/evidence" }
          }
        }
      }
    }
  }
}
