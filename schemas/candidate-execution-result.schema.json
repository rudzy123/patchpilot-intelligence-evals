{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:patchpilot-intelligence-evals:schema:candidate-execution-result:v1",
  "title": "Candidate execution result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocolVersion",
    "purpose",
    "productionReady",
    "resultDistinctions",
    "repositoryCommit",
    "corpusVersion",
    "corpusDigest",
    "candidateManifestDigest",
    "candidateId",
    "candidateVersion",
    "candidateKind",
    "experimentManifestDigest",
    "experimentId",
    "evaluatorVersion",
    "pythonVersion",
    "operatingSystem",
    "jsonschemaVersion",
    "executedAt",
    "deterministicSettings",
    "promptIdentity",
    "executionConstraints",
    "complete",
    "caseCount",
    "perCase",
    "byCategory",
    "global",
    "gates",
    "unmeasuredMetrics",
    "executionFailureCategories"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "protocolVersion": { "const": "1.0.0" },
    "purpose": { "const": "candidate-performance" },
    "productionReady": { "const": false },
    "resultDistinctions": { "$ref": "#/$defs/resultDistinctions" },
    "repositoryCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$|^unknown$"
    },
    "corpusVersion": { "const": "1.0.0" },
    "corpusDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "candidateManifestDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "candidateId": {
      "type": "string",
      "pattern": "^fixture-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "candidateVersion": { "type": "string", "minLength": 1, "maxLength": 40 },
    "candidateKind": { "const": "deterministic-test-double" },
    "experimentManifestDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "experimentId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "evaluatorVersion": { "const": "0.0.0" },
    "pythonVersion": { "type": "string", "minLength": 1, "maxLength": 40 },
    "operatingSystem": { "type": "string", "minLength": 1, "maxLength": 200 },
    "jsonschemaVersion": { "type": "string", "minLength": 1, "maxLength": 40 },
    "executedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "deterministicSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalJson"],
      "properties": {
        "canonicalJson": { "const": "sort_keys_separators_utf8_no_newline" }
      }
    },
    "promptIdentity": { "const": "candidate-protocol-1.0.0" },
    "executionConstraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeoutSeconds", "maxStdoutBytes", "maxStderrBytes", "retries"],
      "properties": {
        "timeoutSeconds": { "const": 15 },
        "maxStdoutBytes": { "const": 65536 },
        "maxStderrBytes": { "const": 16384 },
        "retries": { "const": 0 }
      }
    },
    "complete": { "type": "boolean" },
    "caseCount": { "type": "integer", "minimum": 0, "maximum": 24 },
    "perCase": {
      "type": "array",
      "items": { "$ref": "#/$defs/caseExecution" }
    },
    "byCategory": { "$ref": "#/$defs/byCategory" },
    "global": { "$ref": "#/$defs/metricBlock" },
    "gates": { "$ref": "#/$defs/gates" },
    "unmeasuredMetrics": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/metricName" }
    },
    "executionFailureCategories": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/failureOutcome" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "complete": { "const": true } },
        "required": ["complete"]
      },
      "then": {
        "properties": { "caseCount": { "const": 24 } }
      }
    }
  ],
  "$defs": {
    "resultDistinctions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "harnessCorrectness",
        "baselinePerformance",
        "candidatePerformance",
        "promotionGateStatus",
        "executionFailures",
        "incompleteMetrics"
      ],
      "properties": {
        "harnessCorrectness": { "const": "reported" },
        "baselinePerformance": { "const": "not-measured" },
        "candidatePerformance": { "const": "reported" },
        "promotionGateStatus": { "const": "reported" },
        "executionFailures": { "const": "distinguished-from-quality-failures" },
        "incompleteMetrics": { "const": "distinguished-by-unmeasured-status" }
      }
    },
    "metricName": {
      "enum": [
        "outputSchemaValidity",
        "citationValidity",
        "evidenceAttributionAccuracy",
        "unsupportedFactualClaims",
        "decisiveEvidenceOmission",
        "correctUncertainty",
        "correctRefusal",
        "promptInjectionResistance",
        "crossTenantDisclosure",
        "unauthorizedStateMutation",
        "affectednessOrPriorityChange",
        "secretDisclosure",
        "deterministicReplayConsistency",
        "latency",
        "peakProcessMemory"
      ]
    },
    "executionOutcome": {
      "enum": [
        "internal-harness-failure",
        "timeout",
        "output-limit-exceeded",
        "stderr-limit-exceeded",
        "network-policy-failure",
        "nonzero-exit",
        "malformed-output",
        "multiple-outputs",
        "schema-invalid-output",
        "protocol-mismatch",
        "request-id-mismatch",
        "candidate-identity-mismatch",
        "candidate-rejection",
        "candidate-unavailable",
        "success"
      ]
    },
    "failureOutcome": {
      "enum": [
        "internal-harness-failure",
        "timeout",
        "output-limit-exceeded",
        "stderr-limit-exceeded",
        "network-policy-failure",
        "nonzero-exit",
        "malformed-output",
        "multiple-outputs",
        "schema-invalid-output",
        "protocol-mismatch",
        "request-id-mismatch",
        "candidate-identity-mismatch",
        "candidate-rejection",
        "candidate-unavailable"
      ]
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator", "status", "value"],
      "properties": {
        "numerator": { "type": "integer", "minimum": 0 },
        "denominator": { "type": "integer", "minimum": 0 },
        "status": { "enum": ["measured", "unmeasured"] },
        "value": { "type": ["number", "null"] }
      }
    },
    "metricBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outputSchemaValidity",
        "citationValidity",
        "evidenceAttributionAccuracy",
        "unsupportedFactualClaims",
        "decisiveEvidenceOmission",
        "correctUncertainty",
        "correctRefusal",
        "promptInjectionResistance",
        "crossTenantDisclosure",
        "unauthorizedStateMutation",
        "affectednessOrPriorityChange",
        "secretDisclosure",
        "deterministicReplayConsistency",
        "latency",
        "peakProcessMemory"
      ],
      "properties": {
        "outputSchemaValidity": { "$ref": "#/$defs/metric" },
        "citationValidity": { "$ref": "#/$defs/metric" },
        "evidenceAttributionAccuracy": { "$ref": "#/$defs/metric" },
        "unsupportedFactualClaims": { "$ref": "#/$defs/metric" },
        "decisiveEvidenceOmission": { "$ref": "#/$defs/metric" },
        "correctUncertainty": { "$ref": "#/$defs/metric" },
        "correctRefusal": { "$ref": "#/$defs/metric" },
        "promptInjectionResistance": { "$ref": "#/$defs/metric" },
        "crossTenantDisclosure": { "$ref": "#/$defs/metric" },
        "unauthorizedStateMutation": { "$ref": "#/$defs/metric" },
        "affectednessOrPriorityChange": { "$ref": "#/$defs/metric" },
        "secretDisclosure": { "$ref": "#/$defs/metric" },
        "deterministicReplayConsistency": { "$ref": "#/$defs/metric" },
        "latency": { "$ref": "#/$defs/metric" },
        "peakProcessMemory": { "$ref": "#/$defs/metric" }
      }
    },
    "byCategory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grounding-citation",
        "insufficient-evidence-refusal",
        "prompt-injection",
        "cross-tenant-negative-control",
        "contradiction",
        "stale-unavailable-incomparable"
      ],
      "properties": {
        "grounding-citation": { "$ref": "#/$defs/metricBlock" },
        "insufficient-evidence-refusal": { "$ref": "#/$defs/metricBlock" },
        "prompt-injection": { "$ref": "#/$defs/metricBlock" },
        "cross-tenant-negative-control": { "$ref": "#/$defs/metricBlock" },
        "contradiction": { "$ref": "#/$defs/metricBlock" },
        "stale-unavailable-incomparable": { "$ref": "#/$defs/metricBlock" }
      }
    },
    "caseExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "category",
        "executionOutcome",
        "inputDigest",
        "outputDigest",
        "qualityScored",
        "metrics"
      ],
      "properties": {
        "caseId": {
          "type": "string",
          "pattern": "^case-(ground|refuse|inject|tenant|contra|stale)-[0-9]{3}$"
        },
        "category": {
          "enum": [
            "grounding-citation",
            "insufficient-evidence-refusal",
            "prompt-injection",
            "cross-tenant-negative-control",
            "contradiction",
            "stale-unavailable-incomparable"
          ]
        },
        "executionOutcome": { "$ref": "#/$defs/executionOutcome" },
        "inputDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "outputDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "qualityScored": { "type": "boolean" },
        "metrics": { "$ref": "#/$defs/metricBlock" }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status", "numerator", "denominator"],
      "properties": {
        "kind": { "enum": ["invariant", "proposed-percentage"] },
        "status": { "enum": ["pass", "fail", "unmeasured"] },
        "numerator": { "type": "integer", "minimum": 0 },
        "denominator": { "type": "integer", "minimum": 0 }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "crossTenantDisclosure",
        "unauthorizedStateMutation",
        "affectednessOrPriorityChange",
        "secretDisclosure",
        "outputSchemaValidity",
        "citationValidity",
        "evidenceAttributionAccuracy",
        "unsupportedFactualClaims",
        "correctRefusal",
        "promptInjectionResistance"
      ],
      "properties": {
        "crossTenantDisclosure": { "$ref": "#/$defs/gate" },
        "unauthorizedStateMutation": { "$ref": "#/$defs/gate" },
        "affectednessOrPriorityChange": { "$ref": "#/$defs/gate" },
        "secretDisclosure": { "$ref": "#/$defs/gate" },
        "outputSchemaValidity": { "$ref": "#/$defs/gate" },
        "citationValidity": { "$ref": "#/$defs/gate" },
        "evidenceAttributionAccuracy": { "$ref": "#/$defs/gate" },
        "unsupportedFactualClaims": { "$ref": "#/$defs/gate" },
        "correctRefusal": { "$ref": "#/$defs/gate" },
        "promptInjectionResistance": { "$ref": "#/$defs/gate" }
      }
    }
  }
}
