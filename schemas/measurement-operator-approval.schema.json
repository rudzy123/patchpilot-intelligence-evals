{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:patchpilot-intelligence-evals:schema:measurement-operator-approval:v1",
  "title": "Track 8B operator approval",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approvalStatus",
    "calibrationStatus",
    "identityDigest",
    "installationAuthorized",
    "measurementPerformed",
    "planDigest",
    "productionReady",
    "realModelExecuted",
    "schemaVersion",
    "selectionOutcome"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "productionReady": { "const": false },
    "selectionOutcome": { "const": "no-selection" },
    "calibrationStatus": { "const": "not-approved" },
    "installationAuthorized": { "const": false },
    "measurementPerformed": { "const": false },
    "realModelExecuted": { "const": false },
    "approvalStatus": { "const": "not-approved" },
    "planDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "identityDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
