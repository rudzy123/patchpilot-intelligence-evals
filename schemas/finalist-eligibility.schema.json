{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:patchpilot-intelligence-evals:schema:finalist-eligibility:v1",
  "title": "Track 7 finalist eligibility",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "result": { "enum": ["pass", "fail"] },
    "grant": { "enum": ["granted", "restricted", "not-granted", "unresolved"] },
    "statement": { "enum": ["stated", "not-stated", "unresolved"] },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "sourceName",
        "url",
        "publisher",
        "retrievedOn",
        "immutableRevision",
        "claim",
        "evidenceClass",
        "applicability",
        "conflictDisposition"
      ],
      "properties": {
        "evidenceId": { "type": "string", "minLength": 3, "maxLength": 80 },
        "sourceName": { "type": "string", "minLength": 3, "maxLength": 120 },
        "url": {
          "type": "string",
          "pattern": "^https://[A-Za-z0-9.-]+(?:/[A-Za-z0-9._~:/?#\\[\\]!$&'()*+,;=%-]*)?$"
        },
        "publisher": { "type": "string", "minLength": 2, "maxLength": 80 },
        "retrievedOn": { "const": "2026-11-11" },
        "immutableRevision": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha" }]
        },
        "claim": { "type": "string", "pattern": "^[^\"']{20,400}$" },
        "evidenceClass": {
          "enum": ["authoritative", "secondary", "conflicting", "unresolved"]
        },
        "applicability": { "type": "string", "minLength": 3, "maxLength": 160 },
        "conflictDisposition": {
          "enum": ["none", "restrictive-reading", "rejected-unofficial", "unresolved"]
        }
      }
    }
  },
  "required": [
    "schemaVersion",
    "productionReady",
    "realModelExecuted",
    "runtimeInstallationStatus",
    "acquisitionStatus",
    "conversionStatus",
    "executionStatus",
    "retrievedOn",
    "finalistCount",
    "finalistModelIds",
    "locallyObservedArtifactDigests",
    "finalists"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "productionReady": { "const": false },
    "realModelExecuted": { "const": false },
    "runtimeInstallationStatus": { "const": "not-installed" },
    "acquisitionStatus": { "const": "not-acquired" },
    "conversionStatus": { "const": "not-performed" },
    "executionStatus": { "const": "not-executed" },
    "retrievedOn": { "const": "2026-11-11" },
    "finalistCount": { "type": "integer", "minimum": 0, "maximum": 4 },
    "finalistModelIds": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3, "maxLength": 160 }
    },
    "locallyObservedArtifactDigests": { "type": "array", "maxItems": 0 },
    "finalists": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "modelId",
          "revision",
          "onnxRevision",
          "publisher",
          "sourceCodeLicense",
          "weightLicense",
          "licenseInstrument",
          "commercialGrant",
          "redistributionGrant",
          "modificationGrant",
          "commercialUseResult",
          "redistributionResult",
          "modificationResult",
          "attributionRequired",
          "revenueThresholdUsd",
          "intendedUse",
          "excludedUse",
          "knownLimitations",
          "languageLimitations",
          "safetyLimitations",
          "reliabilityLimitations",
          "remoteCodeRequired",
          "hostedApiRequired",
          "telemetryRequired",
          "officialCard",
          "remoteCodeResult",
          "modelCardLimitationsResult",
          "mandatoryCriteria",
          "mandatoryStatus",
          "scoringEligible",
          "weightedScore",
          "categoryScores",
          "disqualifiers",
          "unresolvedConflict",
          "conflicts",
          "evidence"
        ],
        "properties": {
          "modelId": { "type": "string", "minLength": 3, "maxLength": 160 },
          "revision": { "$ref": "#/$defs/sha" },
          "onnxRevision": { "$ref": "#/$defs/sha" },
          "publisher": { "type": "string", "minLength": 2, "maxLength": 80 },
          "sourceCodeLicense": { "type": "string", "minLength": 2, "maxLength": 80 },
          "weightLicense": { "type": "string", "minLength": 2, "maxLength": 80 },
          "licenseInstrument": {
            "enum": [
              "revision-license-file",
              "separate-instrument",
              "card-name-only",
              "assumed-from-model-license",
              "absent"
            ]
          },
          "commercialGrant": { "$ref": "#/$defs/grant" },
          "redistributionGrant": { "$ref": "#/$defs/grant" },
          "modificationGrant": { "$ref": "#/$defs/grant" },
          "commercialUseResult": { "$ref": "#/$defs/result" },
          "redistributionResult": { "$ref": "#/$defs/result" },
          "modificationResult": { "$ref": "#/$defs/result" },
          "attributionRequired": { "type": "boolean" },
          "revenueThresholdUsd": {
            "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }]
          },
          "intendedUse": { "type": "string", "minLength": 10, "maxLength": 200 },
          "excludedUse": { "type": "string", "minLength": 10, "maxLength": 200 },
          "knownLimitations": { "$ref": "#/$defs/statement" },
          "languageLimitations": { "$ref": "#/$defs/statement" },
          "safetyLimitations": { "$ref": "#/$defs/statement" },
          "reliabilityLimitations": { "$ref": "#/$defs/statement" },
          "remoteCodeRequired": { "type": "boolean" },
          "hostedApiRequired": { "type": "boolean" },
          "telemetryRequired": { "type": "boolean" },
          "officialCard": { "type": "boolean" },
          "remoteCodeResult": { "$ref": "#/$defs/result" },
          "modelCardLimitationsResult": { "$ref": "#/$defs/result" },
          "mandatoryCriteria": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "explicit-weight-use-license",
              "clear-commercial-use-position",
              "clear-redistribution-position",
              "immutable-official-revision",
              "no-remote-code-requirement",
              "fully-offline-runtime-support",
              "tokenizer-provenance",
              "artifact-digest-capability",
              "local-resource-fit",
              "bounded-subprocess-compatibility",
              "no-mandatory-telemetry",
              "no-tenant-data-requirement",
              "official-model-card",
              "documented-limitations",
              "no-production-dependency"
            ],
            "properties": {
              "explicit-weight-use-license": { "$ref": "#/$defs/result" },
              "clear-commercial-use-position": { "$ref": "#/$defs/result" },
              "clear-redistribution-position": { "$ref": "#/$defs/result" },
              "immutable-official-revision": { "$ref": "#/$defs/result" },
              "no-remote-code-requirement": { "$ref": "#/$defs/result" },
              "fully-offline-runtime-support": { "$ref": "#/$defs/result" },
              "tokenizer-provenance": { "$ref": "#/$defs/result" },
              "artifact-digest-capability": { "$ref": "#/$defs/result" },
              "local-resource-fit": { "$ref": "#/$defs/result" },
              "bounded-subprocess-compatibility": { "$ref": "#/$defs/result" },
              "no-mandatory-telemetry": { "$ref": "#/$defs/result" },
              "no-tenant-data-requirement": { "$ref": "#/$defs/result" },
              "official-model-card": { "$ref": "#/$defs/result" },
              "documented-limitations": { "$ref": "#/$defs/result" },
              "no-production-dependency": { "$ref": "#/$defs/result" }
            }
          },
          "mandatoryStatus": { "$ref": "#/$defs/result" },
          "scoringEligible": { "type": "boolean" },
          "weightedScore": {
            "oneOf": [
              { "type": "null" },
              { "type": "integer", "minimum": 0, "maximum": 100 }
            ]
          },
          "categoryScores": {
            "oneOf": [
              { "type": "null" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "license-provenance",
                  "security-offline",
                  "hardware-fit",
                  "evaluation-suitability",
                  "model-card",
                  "runtime-maturity"
                ],
                "properties": {
                  "license-provenance": { "type": "integer", "minimum": 0, "maximum": 25 },
                  "security-offline": { "type": "integer", "minimum": 0, "maximum": 20 },
                  "hardware-fit": { "type": "integer", "minimum": 0, "maximum": 20 },
                  "evaluation-suitability": { "type": "integer", "minimum": 0, "maximum": 20 },
                  "model-card": { "type": "integer", "minimum": 0, "maximum": 10 },
                  "runtime-maturity": { "type": "integer", "minimum": 0, "maximum": 5 }
                }
              }
            ]
          },
          "disqualifiers": {
            "type": "array",
            "maxItems": 15,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 3, "maxLength": 80 }
          },
          "unresolvedConflict": { "type": "boolean" },
          "conflicts": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["conflictId", "status", "disposition", "summary"],
              "properties": {
                "conflictId": { "type": "string", "minLength": 3, "maxLength": 80 },
                "status": { "enum": ["resolved", "unresolved"] },
                "disposition": {
                  "enum": ["none", "restrictive-reading", "rejected-unofficial", "unresolved"]
                },
                "summary": { "type": "string", "pattern": "^[^\"']{20,400}$" }
              }
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": { "$ref": "#/$defs/evidence" }
          }
        }
      }
    }
  }
}
