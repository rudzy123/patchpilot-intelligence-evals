{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:patchpilot-intelligence-evals:schema:offline-local-model-manifest:v1",
  "title": "Offline local model manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocolVersion",
    "candidateId",
    "candidateVersion",
    "candidateKind",
    "officialModelId",
    "immutableRevision",
    "modelOwner",
    "officialSourceUrl",
    "modelCardUrl",
    "weightLicenseUrl",
    "sourceCodeLicenseApplies",
    "sourceCodeLicenseUrl",
    "tokenizerSourceUrl",
    "tokenizerLicenseUrl",
    "configurationSource",
    "expectedArtifacts",
    "observedArtifacts",
    "locallyVerifiedArtifactIdentities",
    "runtimeId",
    "runtimeVersionRequirement",
    "modelFormat",
    "quantization",
    "contextLimitTokens",
    "generationLimitTokens",
    "peakMemoryBudgetBytes",
    "startupTimeoutSeconds",
    "warmPerCaseTimeoutSeconds",
    "networkPolicy",
    "remoteCodePolicy",
    "telemetryPolicy",
    "permittedUses",
    "prohibitedUses",
    "acquisitionStatus",
    "executionStatus",
    "reviewStatus",
    "productionReady",
    "manifestDigest"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "protocolVersion": { "const": "1.0.0" },
    "candidateId": {
      "type": "string",
      "pattern": "^offline-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "candidateVersion": { "type": "string", "minLength": 1, "maxLength": 40 },
    "candidateKind": { "const": "offline-local-model" },
    "officialModelId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,159}$"
    },
    "immutableRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "modelOwner": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]{0,159}$"
    },
    "officialSourceUrl": { "$ref": "#/$defs/httpsUrl" },
    "modelCardUrl": { "$ref": "#/$defs/httpsUrl" },
    "weightLicenseUrl": { "$ref": "#/$defs/httpsUrl" },
    "sourceCodeLicenseApplies": { "type": "boolean" },
    "sourceCodeLicenseUrl": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/httpsUrl" }]
    },
    "tokenizerSourceUrl": { "$ref": "#/$defs/httpsUrl" },
    "tokenizerLicenseUrl": { "$ref": "#/$defs/httpsUrl" },
    "configurationSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "revision"],
      "properties": {
        "url": { "$ref": "#/$defs/httpsUrl" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "expectedArtifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/expectedArtifact" }
    },
    "observedArtifacts": { "type": "array", "maxItems": 0 },
    "locallyVerifiedArtifactIdentities": { "type": "array", "maxItems": 0 },
    "runtimeId": {
      "type": "string",
      "pattern": "^(?:none|[a-z0-9]+(?:-[a-z0-9]+)*)$",
      "maxLength": 80
    },
    "runtimeVersionRequirement": { "type": "string", "minLength": 1, "maxLength": 80 },
    "modelFormat": { "const": "safetensors" },
    "quantization": { "const": "none" },
    "contextLimitTokens": { "type": "integer", "minimum": 1, "maximum": 8192 },
    "generationLimitTokens": { "type": "integer", "minimum": 1, "maximum": 2048 },
    "peakMemoryBudgetBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 12884901888
    },
    "startupTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 180 },
    "warmPerCaseTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 120 },
    "networkPolicy": { "const": "prohibited" },
    "remoteCodePolicy": { "const": "prohibited" },
    "telemetryPolicy": { "const": "disabled" },
    "permittedUses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "const": "offline-harness-evaluation" }
    },
    "prohibitedUses": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "enum": [
        "hosted-inference",
        "model-training",
        "production-decision",
        "provider-execution",
        "state-mutation",
        "tenant-analysis",
        "trust-remote-code",
        "weight-redistribution"
      ] }
    },
    "acquisitionStatus": { "const": "not-acquired" },
    "executionStatus": { "const": "not-executed" },
    "reviewStatus": { "const": "not-authorized" },
    "productionReady": { "const": false },
    "manifestDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "sourceCodeLicenseApplies": { "const": true } },
        "required": ["sourceCodeLicenseApplies"]
      },
      "then": {
        "properties": { "sourceCodeLicenseUrl": { "type": "string" } }
      }
    },
    {
      "if": {
        "properties": { "sourceCodeLicenseApplies": { "const": false } },
        "required": ["sourceCodeLicenseApplies"]
      },
      "then": {
        "properties": { "sourceCodeLicenseUrl": { "type": "null" } }
      }
    },
    {
      "if": {
        "properties": { "runtimeId": { "const": "none" } },
        "required": ["runtimeId"]
      },
      "then": {
        "properties": { "runtimeVersionRequirement": { "const": "not-authorized" } }
      }
    }
  ],
  "$defs": {
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://[^\\s]+$",
      "maxLength": 300
    },
    "expectedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "expectedBytes", "upstreamSha256"],
      "properties": {
        "fileName": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,120}\\.safetensors$"
        },
        "expectedBytes": { "type": "integer", "minimum": 1, "maximum": 8589934592 },
        "upstreamSha256": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          ]
        }
      }
    }
  }
}
