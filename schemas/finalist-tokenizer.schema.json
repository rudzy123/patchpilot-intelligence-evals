{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:patchpilot-intelligence-evals:schema:finalist-tokenizer:v1",
  "title": "Track 7 finalist tokenizer eligibility",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "sourceName",
        "url",
        "publisher",
        "retrievedOn",
        "immutableRevision",
        "claim",
        "evidenceClass",
        "applicability",
        "conflictDisposition"
      ],
      "properties": {
        "evidenceId": { "type": "string", "minLength": 3, "maxLength": 80 },
        "sourceName": { "type": "string", "minLength": 3, "maxLength": 120 },
        "url": {
          "type": "string",
          "pattern": "^https://[A-Za-z0-9.-]+(?:/[A-Za-z0-9._~:/?#\\[\\]!$&'()*+,;=%-]*)?$"
        },
        "publisher": { "type": "string", "minLength": 2, "maxLength": 80 },
        "retrievedOn": { "const": "2026-11-11" },
        "immutableRevision": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha" }]
        },
        "claim": { "type": "string", "pattern": "^[^\"']{20,400}$" },
        "evidenceClass": {
          "enum": ["authoritative", "secondary", "conflicting", "unresolved"]
        },
        "applicability": { "type": "string", "minLength": 3, "maxLength": 160 },
        "conflictDisposition": {
          "enum": ["none", "restrictive-reading", "rejected-unofficial", "unresolved"]
        }
      }
    }
  },
  "required": [
    "schemaVersion",
    "productionReady",
    "realModelExecuted",
    "runtimeInstallationStatus",
    "acquisitionStatus",
    "conversionStatus",
    "executionStatus",
    "retrievedOn",
    "finalistCount",
    "finalistModelIds",
    "locallyObservedArtifactDigests",
    "finalists"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "productionReady": { "const": false },
    "realModelExecuted": { "const": false },
    "runtimeInstallationStatus": { "const": "not-installed" },
    "acquisitionStatus": { "const": "not-acquired" },
    "conversionStatus": { "const": "not-performed" },
    "executionStatus": { "const": "not-executed" },
    "retrievedOn": { "const": "2026-11-11" },
    "finalistCount": { "type": "integer", "minimum": 0, "maximum": 4 },
    "finalistModelIds": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3, "maxLength": 160 }
    },
    "locallyObservedArtifactDigests": { "type": "array", "maxItems": 0 },
    "finalists": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "modelId",
          "modelRevision",
          "revision",
          "sourceKind",
          "sourceRepository",
          "licenseInstrument",
          "licenseName",
          "commercialUse",
          "redistribution",
          "modification",
          "attributionRequired",
          "offlineOperation",
          "automaticRetrievalRequired",
          "remoteCodeRequired",
          "inventoryComplete",
          "inventory",
          "eligibilityOutcome",
          "evidence"
        ],
        "properties": {
          "modelId": { "type": "string", "minLength": 3, "maxLength": 160 },
          "modelRevision": { "$ref": "#/$defs/sha" },
          "revision": { "$ref": "#/$defs/sha" },
          "sourceKind": { "enum": ["model-revision", "separate-repository", "unresolved"] },
          "sourceRepository": { "type": "string", "minLength": 3, "maxLength": 160 },
          "licenseInstrument": {
            "enum": [
              "revision-license-file",
              "separate-instrument",
              "card-name-only",
              "assumed-from-model-license",
              "absent"
            ]
          },
          "licenseName": { "type": "string", "minLength": 2, "maxLength": 80 },
          "commercialUse": {
            "enum": ["granted", "restricted", "not-granted", "unresolved"]
          },
          "redistribution": {
            "enum": ["granted", "restricted", "not-granted", "unresolved"]
          },
          "modification": {
            "enum": ["granted", "restricted", "not-granted", "unresolved"]
          },
          "attributionRequired": { "type": "boolean" },
          "offlineOperation": { "type": "boolean" },
          "automaticRetrievalRequired": { "type": "boolean" },
          "remoteCodeRequired": { "type": "boolean" },
          "inventoryComplete": { "type": "boolean" },
          "inventory": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["fileName", "role", "listedByteCount", "localDigestRequired"],
              "properties": {
                "fileName": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
                "role": { "enum": ["tokenizer", "configuration"] },
                "listedByteCount": { "type": "integer", "minimum": 0 },
                "localDigestRequired": { "type": "boolean" }
              }
            }
          },
          "eligibilityOutcome": { "enum": ["pass", "fail"] },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": { "$ref": "#/$defs/evidence" }
          }
        }
      }
    }
  }
}
