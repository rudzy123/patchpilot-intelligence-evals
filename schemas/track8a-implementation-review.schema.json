{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:patchpilot-intelligence-evals:schema:track8a-implementation-review:v1",
  "title": "Track 8A implementation review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "acceptedResiduals",
    "allowlistDigest",
    "authorizedScope",
    "calibrationApprovalStatus",
    "candidateAcquisition",
    "candidateAtomicPromotion",
    "candidateFiles",
    "componentReviews",
    "copyFallbackUsed",
    "corpusExecuted",
    "decision",
    "evidenceIdentityDigest",
    "generationPerformed",
    "hardenedOfflineLoad",
    "inferencePerformed",
    "installationAuthorized",
    "longContextMeasurementPerformed",
    "measurementPerformed",
    "networkDenial",
    "notAuthorized",
    "operatorApproval",
    "planDigest",
    "processCleanup",
    "productionReady",
    "providerSharedLibraryDisposition",
    "realModelExecuted",
    "reviewAuthority",
    "reviewDate",
    "reviewDigest",
    "reviewStatus",
    "runtimeAcquisition",
    "runtimeArchive",
    "runtimeAtomicPromotion",
    "runtimeFiles",
    "sameFilesystemPromotion",
    "schemaVersion",
    "selectionOutcome",
    "track8bMeasurementAuthorization"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "productionReady": { "const": false },
    "realModelExecuted": { "const": false },
    "measurementPerformed": { "const": false },
    "inferencePerformed": { "const": false },
    "generationPerformed": { "const": false },
    "corpusExecuted": { "const": false },
    "longContextMeasurementPerformed": { "const": false },
    "installationAuthorized": { "const": false },
    "copyFallbackUsed": { "const": false },
    "sameFilesystemPromotion": { "const": true },
    "selectionOutcome": { "const": "no-selection" },
    "calibrationApprovalStatus": { "const": "not-approved" },
    "operatorApproval": { "const": "accepted" },
    "track8bMeasurementAuthorization": { "const": "not-authorized" },
    "reviewStatus": { "const": "accepted-by-principal-systems-architect" },
    "reviewDate": { "const": "2026-11-16" },
    "reviewAuthority": { "const": "PatchPilot Principal Systems Architect" },
    "decision": {
      "const": "track 8a controlled acquisition approved with documented residuals"
    },
    "authorizedScope": {
      "const": "This approval accepts the Track 8A controlled acquisition, verification, same-filesystem atomic promotion, and hardened offline-load proof with documented residuals. It does not authorize Track 8B measurement, candidate selection, calibration, inference, generation, corpus execution, long-context measurement, or production use. Historical pre-Track-8A authorization records stay unchanged."
    },
    "runtimeAcquisition": { "const": "acquired-and-verified" },
    "candidateAcquisition": { "const": "acquired-and-verified" },
    "runtimeAtomicPromotion": { "const": "passed" },
    "candidateAtomicPromotion": { "const": "passed" },
    "hardenedOfflineLoad": { "const": "passed" },
    "networkDenial": { "const": "passed" },
    "processCleanup": { "const": "passed" },
    "providerSharedLibraryDisposition": {
      "const": "not required for the authorized CPU-only path"
    },
    "planDigest": {
      "const": "349c1d666bb4106e284cd0b41f6bac6b4ea65b9d2c5edee8eb358dfc006aec92"
    },
    "allowlistDigest": {
      "const": "cce59885779e2a0e41761205fde5275df5606bea040fc9366a839017fdf4108e"
    },
    "evidenceIdentityDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "runtimeArchive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "localSha256", "logicalBytes", "upstreamSha256"],
      "properties": {
        "fileName": { "const": "onnxruntime-linux-x64-1.31.1.tgz" },
        "logicalBytes": { "const": 11413655 },
        "localSha256": {
          "const": "c849e36a1ef3e22d4ff217b9d1ce4a3cf5b9467b975610913ae959ad5b16bdc9"
        },
        "upstreamSha256": {
          "const": "c849e36a1ef3e22d4ff217b9d1ce4a3cf5b9467b975610913ae959ad5b16bdc9"
        }
      }
    },
    "runtimeFiles": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/fileRow" }
    },
    "candidateFiles": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": { "$ref": "#/$defs/fileRow" }
    },
    "componentReviews": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": { "$ref": "#/$defs/component" }
    },
    "acceptedResiduals": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/residual" }
    },
    "notAuthorized": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 80 }
    },
    "reviewDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "$defs": {
    "fileRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "localSha256", "logicalBytes", "role", "upstreamSha256"],
      "properties": {
        "fileName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_./-]{0,80}$" },
        "logicalBytes": { "type": "integer", "minimum": 1, "maximum": 8589934592 },
        "localSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "upstreamSha256": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          ]
        },
        "role": {
          "enum": [
            "configuration",
            "external-data",
            "graph",
            "license",
            "notice",
            "readme",
            "runtime-identity",
            "runtime-library",
            "tokenizer"
          ]
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["componentId", "disposition", "statement"],
      "properties": {
        "componentId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "disposition": {
          "enum": ["approved", "closed", "not-authorized", "not-required"]
        },
        "statement": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "residual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["residualId", "statement"],
      "properties": {
        "residualId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "statement": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    }
  }
}
