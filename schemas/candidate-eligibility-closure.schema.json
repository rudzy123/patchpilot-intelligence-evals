{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:patchpilot-intelligence-evals:schema:candidate-eligibility-closure:v1",
  "title": "Candidate eligibility closure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "productionReady",
    "realModelExecuted",
    "runtimeInstallationStatus",
    "acquisitionStatus",
    "conversionStatus",
    "executionStatus",
    "retrievedOn",
    "selectionOutcome",
    "selectedModelId",
    "scoringApplied",
    "qualifyingCandidateCount",
    "locallyObservedArtifactDigests",
    "candidates"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "productionReady": { "const": false },
    "realModelExecuted": { "const": false },
    "runtimeInstallationStatus": { "const": "not-installed" },
    "acquisitionStatus": { "const": "not-acquired" },
    "conversionStatus": { "const": "not-performed" },
    "executionStatus": { "const": "not-executed" },
    "retrievedOn": { "const": "2026-11-11" },
    "selectionOutcome": { "enum": ["no-selection", "selected"] },
    "selectedModelId": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/modelId" }]
    },
    "scoringApplied": { "type": "boolean" },
    "qualifyingCandidateCount": { "type": "integer", "minimum": 0, "maximum": 1 },
    "locallyObservedArtifactDigests": { "type": "array", "maxItems": 0 },
    "candidates": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/candidate" }
    }
  },
  "$defs": {
    "modelId": {
      "enum": [
        "Qwen/Qwen2.5-1.5B-Instruct",
        "Qwen/Qwen2.5-3B-Instruct",
        "HuggingFaceTB/SmolLM2-1.7B-Instruct",
        "allenai/OLMo-2-0425-1B-Instruct",
        "google/gemma-3-1b-it"
      ]
    },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "state": {
      "enum": ["pass", "fail", "unresolved", "conflicting", "not-applicable"]
    },
    "grant": { "enum": ["granted", "restricted", "not-granted", "unresolved"] },
    "criterionName": {
      "enum": [
        "explicit-weight-use-license",
        "clear-commercial-use-position",
        "clear-redistribution-position",
        "immutable-official-revision",
        "no-remote-code-requirement",
        "fully-offline-runtime-support",
        "tokenizer-provenance",
        "artifact-digest-capability",
        "local-resource-fit",
        "bounded-subprocess-compatibility",
        "no-mandatory-telemetry",
        "no-tenant-data-requirement",
        "official-model-card",
        "documented-limitations",
        "no-production-dependency"
      ]
    },
    "criterionMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "explicit-weight-use-license",
        "clear-commercial-use-position",
        "clear-redistribution-position",
        "immutable-official-revision",
        "no-remote-code-requirement",
        "fully-offline-runtime-support",
        "tokenizer-provenance",
        "artifact-digest-capability",
        "local-resource-fit",
        "bounded-subprocess-compatibility",
        "no-mandatory-telemetry",
        "no-tenant-data-requirement",
        "official-model-card",
        "documented-limitations",
        "no-production-dependency"
      ],
      "properties": {
        "explicit-weight-use-license": { "enum": ["pass", "fail"] },
        "clear-commercial-use-position": { "enum": ["pass", "fail"] },
        "clear-redistribution-position": { "enum": ["pass", "fail"] },
        "immutable-official-revision": { "enum": ["pass", "fail"] },
        "no-remote-code-requirement": { "enum": ["pass", "fail"] },
        "fully-offline-runtime-support": { "enum": ["pass", "fail"] },
        "tokenizer-provenance": { "enum": ["pass", "fail"] },
        "artifact-digest-capability": { "enum": ["pass", "fail"] },
        "local-resource-fit": { "enum": ["pass", "fail"] },
        "bounded-subprocess-compatibility": { "enum": ["pass", "fail"] },
        "no-mandatory-telemetry": { "enum": ["pass", "fail"] },
        "no-tenant-data-requirement": { "enum": ["pass", "fail"] },
        "official-model-card": { "enum": ["pass", "fail"] },
        "documented-limitations": { "enum": ["pass", "fail"] },
        "no-production-dependency": { "enum": ["pass", "fail"] }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "status", "restrictiveInterpretation"],
      "properties": {
        "topic": { "type": "string", "minLength": 1, "maxLength": 80 },
        "status": {
          "enum": ["resolved", "unresolved", "conflicting", "failed", "not-applicable"]
        },
        "restrictiveInterpretation": { "type": "string", "minLength": 1, "maxLength": 400 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "sourceName",
        "url",
        "publisher",
        "retrievedOn",
        "immutableRevision",
        "claim",
        "evidenceClass",
        "applicability",
        "conflictDisposition"
      ],
      "properties": {
        "evidenceId": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "sourceName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "url": { "type": "string", "pattern": "^https://\\S+$", "maxLength": 300 },
        "publisher": { "type": "string", "minLength": 1, "maxLength": 120 },
        "retrievedOn": { "const": "2026-11-11" },
        "immutableRevision": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/revision" }]
        },
        "claim": { "type": "string", "minLength": 1, "maxLength": 400 },
        "evidenceClass": {
          "enum": ["authoritative", "secondary", "conflicting", "unresolved"]
        },
        "applicability": { "type": "string", "minLength": 1, "maxLength": 160 },
        "conflictDisposition": {
          "enum": ["none", "restrictive-reading", "rejected-unofficial", "unresolved"]
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelId",
        "revision",
        "priorBlockers",
        "weightLicenseResult",
        "codeLicenseResult",
        "commercialUseResult",
        "commercialGrant",
        "redistributionResult",
        "acceptableUseResult",
        "modelCardLimitationsResult",
        "remoteCodeResult",
        "officialSourceResult",
        "mandatoryCriteria",
        "mandatoryStatus",
        "scoringEligible",
        "weightedScore",
        "disqualifiers",
        "conflicts",
        "evidence"
      ],
      "properties": {
        "modelId": { "$ref": "#/$defs/modelId" },
        "revision": { "$ref": "#/$defs/revision" },
        "priorBlockers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
        },
        "weightLicenseResult": { "$ref": "#/$defs/state" },
        "codeLicenseResult": { "$ref": "#/$defs/state" },
        "commercialUseResult": { "$ref": "#/$defs/state" },
        "commercialGrant": { "$ref": "#/$defs/grant" },
        "redistributionResult": { "$ref": "#/$defs/state" },
        "acceptableUseResult": { "$ref": "#/$defs/state" },
        "modelCardLimitationsResult": { "$ref": "#/$defs/state" },
        "remoteCodeResult": { "$ref": "#/$defs/state" },
        "officialSourceResult": { "$ref": "#/$defs/state" },
        "mandatoryCriteria": { "$ref": "#/$defs/criterionMap" },
        "mandatoryStatus": { "enum": ["pass", "fail"] },
        "scoringEligible": { "type": "boolean" },
        "weightedScore": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 0, "maximum": 100 }
          ]
        },
        "disqualifiers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/criterionName" }
        },
        "conflicts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/conflict" }
        },
        "evidence": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    }
  }
}
