{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:patchpilot-intelligence-evals:schema:candidate-discovery:v1",
  "title": "Track 7 candidate discovery",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "sourceName",
        "url",
        "publisher",
        "retrievedOn",
        "immutableRevision",
        "claim",
        "evidenceClass",
        "applicability",
        "conflictDisposition"
      ],
      "properties": {
        "evidenceId": { "type": "string", "minLength": 3, "maxLength": 80 },
        "sourceName": { "type": "string", "minLength": 3, "maxLength": 120 },
        "url": {
          "type": "string",
          "pattern": "^https://[A-Za-z0-9.-]+(?:/[A-Za-z0-9._~:/?#\\[\\]!$&'()*+,;=%-]*)?$"
        },
        "publisher": { "type": "string", "minLength": 2, "maxLength": 80 },
        "retrievedOn": { "const": "2026-11-11" },
        "immutableRevision": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha" }] },
        "claim": { "type": "string", "pattern": "^[^\"']{20,400}$" },
        "evidenceClass": {
          "enum": ["authoritative", "secondary", "conflicting", "unresolved"]
        },
        "applicability": { "type": "string", "minLength": 3, "maxLength": 160 },
        "conflictDisposition": {
          "enum": ["none", "restrictive-reading", "rejected-unofficial", "unresolved"]
        }
      }
    }
  },
  "required": [
    "schemaVersion",
    "productionReady",
    "realModelExecuted",
    "runtimeInstallationStatus",
    "acquisitionStatus",
    "conversionStatus",
    "executionStatus",
    "retrievedOn",
    "discoveryLimit",
    "finalistLimit",
    "parameterMinimum",
    "parameterMaximum",
    "contextFloorTokens",
    "artifactCapBytes",
    "priorCheckpoints",
    "deniedFamilyIds",
    "discoveryCandidateCount",
    "finalistCount",
    "finalistModelIds",
    "locallyObservedArtifactDigests",
    "candidates"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "productionReady": { "const": false },
    "realModelExecuted": { "const": false },
    "runtimeInstallationStatus": { "const": "not-installed" },
    "acquisitionStatus": { "const": "not-acquired" },
    "conversionStatus": { "const": "not-performed" },
    "executionStatus": { "const": "not-executed" },
    "retrievedOn": { "const": "2026-11-11" },
    "discoveryLimit": { "const": 8 },
    "finalistLimit": { "const": 4 },
    "parameterMinimum": { "const": 500000000 },
    "parameterMaximum": { "const": 3200000000 },
    "contextFloorTokens": { "const": 4096 },
    "artifactCapBytes": { "const": 8589934592 },
    "priorCheckpoints": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["modelId", "revision"],
        "properties": {
          "modelId": { "type": "string", "minLength": 3, "maxLength": 160 },
          "revision": { "$ref": "#/$defs/sha" }
        }
      }
    },
    "deniedFamilyIds": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "enum": ["gemma-3", "olmo-2", "qwen2.5", "smollm2"] }
    },
    "discoveryCandidateCount": { "type": "integer", "minimum": 0, "maximum": 8 },
    "finalistCount": { "type": "integer", "minimum": 0, "maximum": 4 },
    "finalistModelIds": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 160,
        "not": {
          "enum": [
            "Qwen/Qwen2.5-1.5B-Instruct",
            "Qwen/Qwen2.5-3B-Instruct",
            "HuggingFaceTB/SmolLM2-1.7B-Instruct",
            "allenai/OLMo-2-0425-1B-Instruct",
            "google/gemma-3-1b-it"
          ]
        }
      }
    },
    "locallyObservedArtifactDigests": { "type": "array", "maxItems": 0 },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "modelId",
          "familyId",
          "publisher",
          "parameterCount",
          "contextTokens",
          "instructionCapable",
          "officialCard",
          "revision",
          "onnxRevision",
          "weightLicenseInitial",
          "tokenizerEvidenceInitial",
          "directOnnxInitial",
          "listedArtifactBytes",
          "cpuOnlyPlausible",
          "remoteCodeRequired",
          "automaticRetrievalIndication",
          "hostedApiRequired",
          "telemetryRequired",
          "conversionRequired",
          "quantizationRequired",
          "priorFamilyStatus",
          "materialDifference",
          "exclusionReasons",
          "preScreenOutcome",
          "evidence"
        ],
        "properties": {
          "modelId": {
            "type": "string",
            "minLength": 3,
            "maxLength": 160,
            "allOf": [
              { "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$" },
              {
                "not": {
                  "pattern": "(?i)(?:^|/)(?:gemma-3|olmo-2|qwen2\\.5|smollm2)(?![A-Za-z0-9])"
                }
              },
              {
                "not": {
                  "enum": [
                    "Qwen/Qwen2.5-1.5B-Instruct",
                    "Qwen/Qwen2.5-3B-Instruct",
                    "HuggingFaceTB/SmolLM2-1.7B-Instruct",
                    "allenai/OLMo-2-0425-1B-Instruct",
                    "google/gemma-3-1b-it"
                  ]
                }
              }
            ]
          },
          "familyId": {
            "type": "string",
            "allOf": [
              { "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
              {
                "not": {
                  "pattern": "(?:^|[^a-z0-9])(?:gemma-3|olmo-2|qwen2\\.5|smollm2)(?![a-z0-9])"
                }
              },
              { "not": { "enum": ["gemma-3", "olmo-2", "qwen2.5", "smollm2"] } }
            ]
          },
          "publisher": { "type": "string", "minLength": 2, "maxLength": 80 },
          "parameterCount": {
            "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }]
          },
          "contextTokens": {
            "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }]
          },
          "instructionCapable": { "type": "boolean" },
          "officialCard": { "type": "boolean" },
          "revision": {
            "allOf": [
              { "$ref": "#/$defs/sha" },
              {
                "not": {
                  "enum": [
                    "989aa7980e4cf806f80c7fef2b1adb7bc71aa306",
                    "aa8e72537993ba99e69dfaafa59ed015b17504d1",
                    "31b70e2e869a7173562077fd711b654946d38674",
                    "48d788eca847d4d7548f375ad03d3c9312f6139e",
                    "dcc83ea841ab6100d6b47a070329e1ba4cf78752"
                  ]
                }
              }
            ]
          },
          "onnxRevision": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/sha" }] },
          "weightLicenseInitial": {
            "enum": ["revision-instrument", "card-name-only", "absent"]
          },
          "tokenizerEvidenceInitial": {
            "enum": ["revision-file", "card-named", "remote-code", "absent"]
          },
          "directOnnxInitial": {
            "enum": [
              "official-nonquantized",
              "official-quantized-only",
              "third-party",
              "absent"
            ]
          },
          "listedArtifactBytes": {
            "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }]
          },
          "cpuOnlyPlausible": { "type": "boolean" },
          "remoteCodeRequired": { "type": "boolean" },
          "automaticRetrievalIndication": { "type": "boolean" },
          "hostedApiRequired": { "type": "boolean" },
          "telemetryRequired": { "type": "boolean" },
          "conversionRequired": { "type": "boolean" },
          "quantizationRequired": { "type": "boolean" },
          "priorFamilyStatus": {
            "enum": ["distinct", "prior-checkpoint", "same-family-size", "duplicate"]
          },
          "materialDifference": { "type": "string", "minLength": 20, "maxLength": 400 },
          "exclusionReasons": {
            "type": "array",
            "maxItems": 17,
            "uniqueItems": true,
            "items": {
              "enum": [
                "artifact-cap",
                "artifact-unknown",
                "automatic-retrieval",
                "context-floor",
                "context-unknown",
                "conversion-required",
                "cpu-not-plausible",
                "direct-onnx",
                "hosted-api",
                "instruction-or-card",
                "parameter-band",
                "parameter-unknown",
                "prior-checkpoint",
                "quantization-required",
                "remote-code",
                "telemetry",
                "weight-terms-absent"
              ]
            }
          },
          "preScreenOutcome": { "enum": ["advance", "exclude"] },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": { "$ref": "#/$defs/evidence" }
          }
        }
      }
    }
  }
}
