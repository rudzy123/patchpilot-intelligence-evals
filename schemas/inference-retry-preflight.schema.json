{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:patchpilot-intelligence-evals:schema:inference-retry-preflight:v1",
  "title": "Track 8B-R2 preflight or template compatibility",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "archiveAttemptId",
    "calibrationStatus",
    "candidateAttemptId",
    "candidateClass",
    "compatibility",
    "consumedRetryPlanDigest",
    "contentClass",
    "dependencyClosureDigest",
    "dynamicLinkPrecheckDigest",
    "identityDigest",
    "installationAuthorized",
    "measurementCompleted",
    "measurementPerformed",
    "modelSessionCreated",
    "planDigest",
    "priorPlanDigest",
    "productionReady",
    "realModelExecuted",
    "recordKind",
    "renderedDigest",
    "renderedShape",
    "resultRootClass",
    "runInvoked",
    "runtimeAttemptId",
    "runtimeClass",
    "schemaVersion",
    "selectionOutcome",
    "sessionCreated",
    "sessionId",
    "status",
    "templateDigest",
    "timestamp"
  ],
  "properties": {
    "archiveAttemptId": { "const": "rt-e791f1518ae46ead" },
    "candidateAttemptId": { "const": "cd-20b7ceee37a62cba" },
    "runtimeAttemptId": { "const": "rp-c2fe1c88f694fc1e" },
    "candidateClass": { "const": "verified-candidate" },
    "runtimeClass": { "const": "verified-runtime" },
    "recordKind": { "enum": ["preflight", "template-compatibility"] },
    "status": {
      "enum": [
        "not-executed",
        "ok",
        "supported",
        "identity-mismatch",
        "invalid-rendered-prompt",
        "unsupported-construct",
        "unsupported-template-language",
        "rendering-failure",
        "compatibility-failure"
      ]
    },
    "compatibility": {
      "anyOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 40 }]
    },
    "contentClass": { "const": "synthetic-user" },
    "renderedDigest": {
      "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9a-f]{64}$" }]
    },
    "renderedShape": {
      "anyOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 80 }]
    },
    "templateDigest": {
      "anyOf": [{ "type": "null" }, { "type": "string", "pattern": "^[0-9a-f]{64}$" }]
    },
    "sessionCreated": { "const": false },
    "timestamp": { "type": "string", "minLength": 1, "maxLength": 40 },
    "planDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "priorPlanDigest": {
      "const": "8280ec639abd60edad7d49c1129d691822c17be06d7ef15aa2fcb5425bdbf0a2"
    },
    "consumedRetryPlanDigest": {
      "const": "572fc9da2bf5c3d378a56764672617849d317df293fdbc29d85b40e70ae27d2b"
    },
    "dependencyClosureDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "dynamicLinkPrecheckDigest": {
      "anyOf": [
        { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        { "const": "not-executed" }
      ]
    },
    "sessionId": { "const": "intelligence-track-8b-r2" },
    "selectionOutcome": { "const": "no-selection" },
    "calibrationStatus": { "const": "not-approved" },
    "productionReady": { "const": false },
    "installationAuthorized": { "const": false },
    "measurementPerformed": { "const": false },
    "measurementCompleted": { "const": false },
    "modelSessionCreated": { "const": false },
    "runInvoked": { "const": false },
    "realModelExecuted": { "const": false },
    "resultRootClass": { "const": "inference-retry-result" },
    "schemaVersion": { "const": "1.0.0" },
    "identityDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
