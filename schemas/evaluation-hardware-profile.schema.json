{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:patchpilot-intelligence-evals:schema:evaluation-hardware-profile:v1",
  "title": "Evaluation hardware profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "productionReady",
    "retrievedOn",
    "operatingSystemFamily",
    "operatingSystemVersion",
    "kernelVersion",
    "cpuArchitecture",
    "logicalCpuCount",
    "totalMemoryKib",
    "storageBytes",
    "availableStorageBytes",
    "gpuAvailability",
    "gpuModel",
    "gpuMemoryBytes",
    "runtimeCapabilities",
    "resourceEnvelope"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "productionReady": { "const": false },
    "retrievedOn": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "operatingSystemFamily": { "enum": ["Linux"] },
    "operatingSystemVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
    "kernelVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
    "cpuArchitecture": { "enum": ["x86_64"] },
    "logicalCpuCount": { "type": "integer", "minimum": 1, "maximum": 1024 },
    "totalMemoryKib": { "type": "integer", "minimum": 1 },
    "storageBytes": { "type": "integer", "minimum": 1 },
    "availableStorageBytes": { "type": "integer", "minimum": 0 },
    "gpuAvailability": { "enum": ["unavailable", "available"] },
    "gpuModel": {
      "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 80 }]
    },
    "gpuMemoryBytes": {
      "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }]
    },
    "runtimeCapabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 120 }
    },
    "resourceEnvelope": { "$ref": "#/$defs/resourceEnvelope" }
  },
  "$defs": {
    "resourceEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximumArtifactBytes",
        "maximumPeakProcessMemoryBytes",
        "maximumContextTokens",
        "maximumExplanationCharacters",
        "maximumGeneratedWords",
        "maximumConcurrentProcesses",
        "maximumConcurrentModelInvocations",
        "timeoutSeconds",
        "gpuRequired",
        "cpuFallbackRequired",
        "minimumFreeStorageMultiple",
        "quantizationApproved"
      ],
      "properties": {
        "maximumArtifactBytes": { "type": "integer", "minimum": 1 },
        "maximumPeakProcessMemoryBytes": { "type": "integer", "minimum": 1 },
        "maximumContextTokens": { "const": 8192 },
        "maximumExplanationCharacters": { "const": 400 },
        "maximumGeneratedWords": { "const": 1200 },
        "maximumConcurrentProcesses": { "const": 1 },
        "maximumConcurrentModelInvocations": { "const": 0 },
        "timeoutSeconds": { "const": 15 },
        "gpuRequired": { "const": false },
        "cpuFallbackRequired": { "type": "boolean" },
        "minimumFreeStorageMultiple": { "const": 2 },
        "quantizationApproved": { "const": false }
      }
    }
  }
}
