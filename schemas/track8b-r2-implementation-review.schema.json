{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:patchpilot-intelligence-evals:schema:track8b-r2-implementation-review:v1",
  "title": "Track 8B-R2 implementation review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attemptOutcome",
    "authorizedScope",
    "behavioralConclusion",
    "calibrationStatus",
    "candidateMetrics",
    "componentReviews",
    "consumedRetryPlanDigest",
    "decision",
    "headroomAssessment",
    "installationAuthorized",
    "measurementCompleted",
    "measurementPerformed",
    "memoryConclusion",
    "modelSessionCreated",
    "notAuthorized",
    "planDigest",
    "planDisposition",
    "priorPlanDigest",
    "productionReady",
    "r3Plan",
    "realModelExecuted",
    "replacementPlanDigest",
    "reviewAuthority",
    "reviewDate",
    "reviewDigest",
    "reviewStatus",
    "runInvoked",
    "schemaVersion",
    "selectionOutcome",
    "sessionId",
    "stopCause",
    "track9Readiness"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "productionReady": { "const": false },
    "selectionOutcome": { "const": "no-selection" },
    "calibrationStatus": { "const": "not-approved" },
    "installationAuthorized": { "const": false },
    "measurementPerformed": { "const": true },
    "measurementCompleted": { "const": false },
    "realModelExecuted": { "const": true },
    "runInvoked": { "const": true },
    "modelSessionCreated": { "const": true },
    "attemptOutcome": { "const": "stopped" },
    "stopCause": { "const": "telemetry-unresolved" },
    "candidateMetrics": { "const": "not-produced" },
    "behavioralConclusion": { "const": "partial-inconclusive" },
    "memoryConclusion": { "const": "within-ceiling" },
    "headroomAssessment": { "const": "limited" },
    "track9Readiness": { "const": "not-ready" },
    "planDisposition": { "const": "consumed" },
    "replacementPlanDigest": { "const": "not-issued" },
    "r3Plan": { "const": "not-issued" },
    "reviewStatus": {
      "const": "memory-measurements-accepted-implementation-pending-commit"
    },
    "reviewDate": { "const": "2026-11-17" },
    "reviewAuthority": { "const": "PatchPilot Principal Systems Architect" },
    "decision": {
      "const": "memory measurements accepted and bounded corrections recorded for review before commit"
    },
    "authorizedScope": {
      "const": "This record accepts the measured memory peaks and records the sampling, forensic, and interpretation corrections. It does not authorize another Run, an R3 plan, candidate selection, calibration, or production use."
    },
    "planDigest": {
      "const": "2133054bea8db11822cc65f6ea9c45f1ba1500f1aef67d314fbccca764155350"
    },
    "priorPlanDigest": {
      "const": "8280ec639abd60edad7d49c1129d691822c17be06d7ef15aa2fcb5425bdbf0a2"
    },
    "consumedRetryPlanDigest": {
      "const": "572fc9da2bf5c3d378a56764672617849d317df293fdbc29d85b40e70ae27d2b"
    },
    "sessionId": { "const": "intelligence-track-8b-r2" },
    "componentReviews": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/component" }
    },
    "notAuthorized": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "type": "string", "minLength": 1, "maxLength": 80 }
    },
    "reviewDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["componentId", "disposition", "statement"],
      "properties": {
        "componentId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "disposition": {
          "enum": ["accepted", "corrected-before-commit", "recorded"]
        },
        "statement": { "type": "string", "minLength": 1, "maxLength": 400 }
      }
    }
  }
}
